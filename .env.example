# Comma-separated, case-insensitive terms
KWORK_SPHERES=Python,парсеры,Telegram-боты
KWORK_SKILLS=FastAPI,FastMCP,SQLite
KWORK_EXCLUDE=tilda,joomla,игра
# Текст отклика: файл (предпочтительно) или строка с \n
KWORK_RESPONSE_TEMPLATE_FILE=response_template.txt
# Плейсхолдеры опциональны: {project_name}, {details}, {about}
KWORK_RESPONSE_TEMPLATE=Здравствуйте!\n\nПо проекту «{project_name}» могу помочь.\n{details}\n\nС уважением, {about}
KWORK_ABOUT=Команда FlowTeam
# Подпись в конце ИИ-отклика (если пусто — берётся KWORK_ABOUT)
KWORK_SIGNATURE=Команда FlowTeam
# Срок (дни) для кнопки «Автоотклик»
KWORK_DEFAULT_DEADLINE=7
KWORK_DB=kwork_responses.db
KWORK_PROJECTS_URL=https://kwork.ru/projects?page={page}
# Логин/пароль — нужны только при первом входе / если сессия устарела
KWORK_LOGIN=
KWORK_PASSWORD=
# Playwright storage state (cookies+localStorage). По умолчанию: kwork-state.json
# После успешного логина файл создаётся автоматически и переиспользуется.
KWORK_STORAGE_STATE=kwork-state.json
# Альтернатива: Cookie-Editor JSON list
KWORK_COOKIES_FILE=
# 0 = видимый браузер (удобно при CAPTCHA), 1 = фоновый
KWORK_HEADLESS=1

# RouterAI — генерация «Своё описание»
# Каталог всех моделей: https://routerai.ru/models/
# Список через API: GET https://routerai.ru/api/v1/models
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
AI_MODEL=deepseek/deepseek-v4-pro
# Популярные AI_MODEL (chat):
#   deepseek/deepseek-v4-pro
#   deepseek/deepseek-v4-flash
